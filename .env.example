TRACEFRAME_API_KEY=tf_REPLACE_WITH_32_BYTES_HEX
TRACEFRAME_ENDPOINT=http://localhost:4000
POSTGRES_USER=traceframe
POSTGRES_PASSWORD=<change-me>
