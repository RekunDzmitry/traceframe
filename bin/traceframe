#!/usr/bin/env node
// traceframe — Claude Code hook CLI.
//
//   traceframe session-start   (SessionStart hook: spawns tail, emits trace.started)
//   traceframe session-stop    (Stop hook: signals tail, emits trace.closed)
//   traceframe tail            (background worker: tails transcript → events)
//   traceframe memory-fetch    (SessionStart hook: prints prior session memories as additionalContext)
//   traceframe memory-write    (SessionEnd hook: triggers server-side distillation)
//
// All expect TRACEFRAME_API_KEY and TRACEFRAME_ENDPOINT in env.
// session-start / session-stop / memory-fetch / memory-write read the hook payload from stdin.

import { readFileSync, existsSync, mkdirSync, statSync, openSync, readSync, closeSync, writeFileSync, unlinkSync, appendFileSync, realpathSync } from "node:fs";
import { spawn, spawnSync } from "node:child_process";
import { join, dirname } from "node:path";
import { tmpdir, hostname } from "node:os";

const ENDPOINT = process.env.TRACEFRAME_ENDPOINT || "http://localhost:4000";
const API_KEY = process.env.TRACEFRAME_API_KEY;
const STATE_DIR = join(tmpdir(), "traceframe");
mkdirSync(STATE_DIR, { recursive: true });

const now = () => new Date().toISOString();
const traceIdFor = (sessionId) => `trc_${sessionId.replace(/[^A-Za-z0-9_-]/g, "").slice(0, 48) || "anon"}`;
const statePath = (sessionId) => join(STATE_DIR, `${sessionId}.json`);
const logPath = (sessionId) => join(STATE_DIR, `${sessionId}.log`);

const log = (sessionId, msg) => {
  try {
    appendFileSync(logPath(sessionId), `[${now()}] ${msg}\n`);
  } catch {}
};

const isAlive = (pid) => {
  if (!pid) return false;
  try { process.kill(pid, 0); return true; } catch { return false; }
};

const readStdinJson = async () => {
  const chunks = [];
  for await (const c of process.stdin) chunks.push(c);
  const raw = Buffer.concat(chunks).toString("utf8").trim();
  if (!raw) return {};
  try { return JSON.parse(raw); } catch { return {}; }
};

const postEvents = async (events) => {
  if (!API_KEY) throw new Error("TRACEFRAME_API_KEY not set");
  const res = await fetch(`${ENDPOINT}/ingest/events`, {
    method: "POST",
    headers: { "content-type": "application/json", authorization: `Bearer ${API_KEY}` },
    body: JSON.stringify({ events }),
  });
  if (!res.ok) throw new Error(`ingest ${res.status}: ${await res.text()}`);
  return res.json();
};

// ─────────────────────────── daemon management ────────────────────────

const DAEMON_PID_FILE = join(STATE_DIR, "daemon.pid");
const DAEMON_LOG_FILE = join(STATE_DIR, "daemon.log");

const daemonStart = async () => {
  if (existsSync(DAEMON_PID_FILE)) {
    const pid = parseInt(readFileSync(DAEMON_PID_FILE, "utf8").trim(), 10);
    if (isAlive(pid)) {
      console.log(`traceframe daemon already running (pid=${pid}, endpoint=${ENDPOINT})`);
      return;
    }
    unlinkSync(DAEMON_PID_FILE);
  }

  const self = realpathSync(process.argv[1]);
  const serverPath = join(dirname(self), "../ingest/server.mjs");
  if (!existsSync(serverPath)) {
    console.error(`daemon: server.mjs not found at ${serverPath}`);
    process.exit(1);
  }

  const logFd = openSync(DAEMON_LOG_FILE, "a");
  const child = spawn(process.execPath, [serverPath], {
    detached: true,
    stdio: ["ignore", logFd, logFd],
    env: process.env,
  });
  child.unref();
  writeFileSync(DAEMON_PID_FILE, String(child.pid));
  console.log(`traceframe daemon started (pid=${child.pid})`);
  console.log(`  logs: ${DAEMON_LOG_FILE}`);
  console.log(`  endpoint: ${ENDPOINT}`);
};

const daemonStop = async () => {
  if (!existsSync(DAEMON_PID_FILE)) {
    console.log("traceframe daemon not running (no pid file)");
    return;
  }
  const pid = parseInt(readFileSync(DAEMON_PID_FILE, "utf8").trim(), 10);
  if (!isAlive(pid)) {
    console.log("traceframe daemon not running (stale pid file, cleaned up)");
    unlinkSync(DAEMON_PID_FILE);
    return;
  }
  try {
    process.kill(pid, "SIGTERM");
    unlinkSync(DAEMON_PID_FILE);
    console.log(`traceframe daemon stopped (pid=${pid})`);
  } catch (e) {
    console.error(`daemon-stop failed: ${e.message}`);
    process.exit(1);
  }
};

const daemonStatus = async () => {
  const running = existsSync(DAEMON_PID_FILE) &&
    isAlive(parseInt(readFileSync(DAEMON_PID_FILE, "utf8").trim(), 10));
  const pid = running ? parseInt(readFileSync(DAEMON_PID_FILE, "utf8").trim(), 10) : null;
  console.log(running
    ? `traceframe daemon running (pid=${pid}, endpoint=${ENDPOINT})`
    : "traceframe daemon stopped"
  );
};

// ─────────────────────────── session-start ───────────────────────────

const sessionStart = async () => {
  const payload = await readStdinJson();
  const sessionId = payload.session_id || payload.sessionId;
  const transcript = payload.transcript_path || payload.transcriptPath;
  if (!sessionId || !transcript) {
    console.error("session-start: missing session_id or transcript_path");
    process.exit(0);
  }

  // Claude Code re-fires SessionStart on compact/resume/clear. Only `compact`
  // is a same-session continuation where a second tail would duplicate every
  // line; `resume`/`clear`/`startup` are new session continuations that need
  // a fresh tail. Suppress on compact, terminate-and-respawn otherwise.
  const sp = statePath(sessionId);
  const source = payload.source || "startup";
  if (existsSync(sp)) {
    try {
      const prev = JSON.parse(readFileSync(sp, "utf8"));
      if (isAlive(prev.tailPid)) {
        if (source === "compact") {
          log(sessionId, `session-start compact re-fire ignored (tail pid=${prev.tailPid} alive)`);
          return;
        }
        log(sessionId, `session-start ${source}: terminating stale tail pid=${prev.tailPid}`);
        try { process.kill(prev.tailPid, "SIGTERM"); } catch {}
      }
    } catch {}
  }

  const traceId = traceIdFor(sessionId);
  const meta = {
    sessionId,
    traceId,
    transcript,
    cwd: payload.cwd || process.cwd(),
    source: payload.source || "startup",
    model: payload.model,
    host: hostname(),
    startedAt: now(),
  };
  writeFileSync(statePath(sessionId), JSON.stringify(meta, null, 2));

  try {
    await postEvents([{
      type: "trace.started",
      at: meta.startedAt,
      traceId,
      sessionId,
      trace: {
        id: traceId,
        title: `Claude Code: ${payload.source || "session"}`,
        repo: meta.cwd,
        branch: "",
        startedAt: meta.startedAt,
        duration: 0,
        totalTokens: 0,
        totalCost: 0,
        status: "running",
      },
      source: meta.source,
      model: meta.model,
      cwd: meta.cwd,
      host: meta.host,
    }]);
  } catch (e) {
    log(sessionId, `trace.started failed: ${e.message}`);
  }

  // Spawn detached tail worker. Inherits env (API key, endpoint).
  const self = process.argv[1];
  const out = openSync(logPath(sessionId), "a");
  const child = spawn(process.execPath, [self, "tail", sessionId], {
    detached: true,
    stdio: ["ignore", out, out],
    env: process.env,
  });
  child.unref();
  log(sessionId, `spawned tail pid=${child.pid}`);

  const state = { ...meta, tailPid: child.pid };
  writeFileSync(statePath(sessionId), JSON.stringify(state, null, 2));
};

// ─────────────────────────── tail worker ───────────────────────────

const BATCH_INTERVAL_MS = 500;
const POLL_INTERVAL_MS = 500;
const MAX_BATCH = 50;

const summarizeMessage = (msg) => {
  if (!msg || typeof msg !== "object") return { text: "", hasToolUse: false, toolUses: [] };
  let text = "";
  const toolUses = [];
  if (typeof msg.content === "string") {
    text = msg.content;
  } else if (Array.isArray(msg.content)) {
    for (const block of msg.content) {
      if (!block || typeof block !== "object") continue;
      if (block.type === "text" && typeof block.text === "string") text += block.text;
      else if (block.type === "tool_use") toolUses.push({ id: block.id, name: block.name, input: block.input });
      else if (block.type === "tool_result") {
        const c = typeof block.content === "string" ? block.content : JSON.stringify(block.content);
        text += `[tool_result ${block.tool_use_id}] ${c}`;
      }
    }
  }
  return { text, hasToolUse: toolUses.length > 0, toolUses };
};

const lineToEvent = (line, traceId, sessionId) => {
  let raw;
  try { raw = JSON.parse(line); } catch { return null; }
  const msg = raw.message || {};
  const summary = summarizeMessage(msg);
  return {
    type: "transcript.line",
    at: raw.timestamp || now(),
    traceId,
    sessionId,
    uuid: raw.uuid,
    parentUuid: raw.parentUuid,
    role: msg.role || raw.type,
    kind: raw.type,
    model: msg.model,
    usage: msg.usage,
    text: summary.text.slice(0, 4000),
    hasToolUse: summary.hasToolUse,
    toolUses: summary.toolUses,
    raw,
  };
};

const tailLoop = async () => {
  const sessionId = process.argv[3];
  if (!sessionId) { console.error("tail: session_id required"); process.exit(1); }
  if (!existsSync(statePath(sessionId))) { console.error("tail: no state file"); process.exit(1); }

  const state = JSON.parse(readFileSync(statePath(sessionId), "utf8"));
  const { traceId, transcript } = state;

  log(sessionId, `tail started pid=${process.pid} transcript=${transcript}`);

  let offset = 0;
  let remainder = "";
  let stopped = false;
  let batch = [];
  let flushTimer = null;

  const flush = async () => {
    if (!batch.length) return;
    const toSend = batch;
    batch = [];
    try {
      await postEvents(toSend);
      log(sessionId, `flushed ${toSend.length}`);
    } catch (e) {
      log(sessionId, `flush failed: ${e.message}; re-queueing ${toSend.length}`);
      batch.unshift(...toSend);
    }
  };

  const scheduleFlush = () => {
    if (flushTimer) return;
    flushTimer = setTimeout(async () => {
      flushTimer = null;
      await flush();
    }, BATCH_INTERVAL_MS);
  };

  const enqueue = (ev) => {
    batch.push(ev);
    if (batch.length >= MAX_BATCH) {
      if (flushTimer) { clearTimeout(flushTimer); flushTimer = null; }
      flush();
    } else {
      scheduleFlush();
    }
  };

  const poll = () => {
    if (stopped) return;
    if (!existsSync(transcript)) {
      setTimeout(poll, POLL_INTERVAL_MS);
      return;
    }
    let st;
    try { st = statSync(transcript); } catch { setTimeout(poll, POLL_INTERVAL_MS); return; }

    if (st.size < offset) {
      log(sessionId, `transcript shrank ${offset} → ${st.size}, resetting`);
      offset = 0;
      remainder = "";
    }
    if (st.size > offset) {
      const fd = openSync(transcript, "r");
      const buf = Buffer.alloc(st.size - offset);
      try { readSync(fd, buf, 0, buf.length, offset); } finally { closeSync(fd); }
      offset = st.size;
      const chunk = remainder + buf.toString("utf8");
      const lines = chunk.split("\n");
      remainder = lines.pop() || "";
      for (const line of lines) {
        if (!line.trim()) continue;
        const ev = lineToEvent(line, traceId, sessionId);
        if (ev) enqueue(ev);
      }
    }
    setTimeout(poll, POLL_INTERVAL_MS);
  };

  const shutdown = async (signal) => {
    if (stopped) return;
    stopped = true;
    log(sessionId, `shutdown signal=${signal}`);
    if (flushTimer) { clearTimeout(flushTimer); flushTimer = null; }
    await flush();
    process.exit(0);
  };
  process.on("SIGTERM", () => shutdown("SIGTERM"));
  process.on("SIGINT", () => shutdown("SIGINT"));

  poll();
};

// ─────────────────────────── memory helpers ───────────────────────────

const repoTag = (cwd) => {
  const dir = cwd || process.cwd();
  try {
    const r = spawnSync("git", ["-C", dir, "config", "--get", "remote.origin.url"], {
      encoding: "utf8",
      timeout: 1000,
    });
    if (r.status === 0 && r.stdout) {
      let url = r.stdout.trim().toLowerCase();
      if (url.endsWith(".git")) url = url.slice(0, -4);
      // git@host:path → host/path
      const m = url.match(/^git@([^:]+):(.+)$/);
      if (m) url = `${m[1]}/${m[2]}`;
      // protocol://host/path → host/path
      url = url.replace(/^[a-z]+:\/\/(?:[^@]+@)?/, "");
      if (url) return url;
    }
  } catch {}
  try { return realpathSync(dir); } catch { return dir; }
};

const memoryFetch = async () => {
  const payload = await readStdinJson();
  if (payload.source === "compact") return; // don't reinject on compaction
  const tag = repoTag(payload.cwd || process.cwd());

  const ctrl = new AbortController();
  const timer = setTimeout(() => ctrl.abort(), 1500);
  let data;
  try {
    const url = `${ENDPOINT}/memory/recent?repo=${encodeURIComponent(tag)}&limit=3`;
    const headers = API_KEY ? { authorization: `Bearer ${API_KEY}` } : {};
    const res = await fetch(url, { headers, signal: ctrl.signal });
    if (!res.ok) return;
    data = await res.json();
  } catch {
    return; // silent: no memory yet, server down, timeout, etc.
  } finally {
    clearTimeout(timer);
  }

  const memories = Array.isArray(data?.memories) ? data.memories : [];
  if (!memories.length) return;

  const sections = memories.map((m, i) => {
    const heading = i === 0 ? "Most recent" : `Older (${m.createdAt})`;
    const tail = m.traceId ? ` — \`${m.traceId.slice(-8)}\`` : "";
    return `### ${heading}${tail}\n\n${m.summary}`;
  });
  const md = `## Prior context for this repo (\`${tag}\`)\n\n${sections.join("\n\n---\n\n")}`;

  const out = {
    hookSpecificOutput: {
      hookEventName: "SessionStart",
      additionalContext: md,
    },
  };
  console.log(JSON.stringify(out));
};

const memoryWrite = async () => {
  const payload = await readStdinJson();
  const sessionId = payload.session_id || payload.sessionId;
  if (!sessionId) return;
  const sp = statePath(sessionId);
  if (!existsSync(sp)) {
    log(sessionId, "memory-write: no state file");
    return;
  }
  let state;
  try {
    state = JSON.parse(readFileSync(sp, "utf8"));
  } catch {
    return;
  }
  const tag = repoTag(state.cwd);

  const ctrl = new AbortController();
  const timer = setTimeout(() => ctrl.abort(), 5000);
  try {
    const headers = { "content-type": "application/json" };
    if (API_KEY) headers.authorization = `Bearer ${API_KEY}`;
    const res = await fetch(`${ENDPOINT}/memory/distill/${encodeURIComponent(sessionId)}`, {
      method: "POST",
      headers,
      body: JSON.stringify({ repo_tag: tag, trace_id: state.traceId }),
      signal: ctrl.signal,
    });
    log(sessionId, `memory-write: ${res.status} (repo=${tag})`);
  } catch (e) {
    log(sessionId, `memory-write failed: ${e.message}`);
  } finally {
    clearTimeout(timer);
  }
};

// ─────────────────────────── gitnexus-index ─────────────────────────

const gitnexusIndex = async () => {
  const argPath = process.argv[3];
  const rootPath = argPath ? realpathSync(argPath) : process.cwd();
  const tag = repoTag(rootPath);

  const headers = { "content-type": "application/json" };
  if (API_KEY) headers.authorization = `Bearer ${API_KEY}`;

  let res;
  try {
    res = await fetch(`${ENDPOINT}/codegraph/index`, {
      method: "POST",
      headers,
      body: JSON.stringify({ repoTag: tag, path: rootPath }),
    });
  } catch (e) {
    console.error(`gitnexus-index: failed to reach ${ENDPOINT}: ${e.message}`);
    process.exit(1);
  }
  if (!res.ok) {
    const detail = await res.text().catch(() => "");
    console.error(`gitnexus-index: server returned ${res.status}\n${detail.slice(0, 300)}`);
    process.exit(1);
  }
  console.log(`indexing ${tag} (${rootPath})…`);

  // Poll status for up to 60s; report transitions.
  const statusUrl = `${ENDPOINT}/codegraph/repo?tag=${encodeURIComponent(tag)}`;
  const statusHeaders = API_KEY ? { authorization: `Bearer ${API_KEY}` } : {};
  let last = null;
  const deadline = Date.now() + 60_000;
  while (Date.now() < deadline) {
    await new Promise((r) => setTimeout(r, 1000));
    let s;
    try {
      const r = await fetch(statusUrl, { headers: statusHeaders });
      if (!r.ok) continue;
      s = (await r.json()).repo;
    } catch { continue; }
    if (!s) continue;
    if (s.status !== last) {
      console.log(`  ${s.status}${s.statusError ? ": " + s.statusError : ""}`);
      last = s.status;
    }
    if (s.status === "ready") {
      console.log(`  ${s.fileCount} files, ${s.symbolCount} symbols`);
      return;
    }
    if (s.status === "failed") {
      process.exit(1);
    }
  }
  console.log("  still indexing — check the dashboard for progress.");
};

// ─────────────────────────── session-stop ───────────────────────────

const sessionStop = async () => {
  const payload = await readStdinJson();
  const sessionId = payload.session_id || payload.sessionId;
  if (!sessionId) { console.error("session-stop: missing session_id"); process.exit(0); }

  const sp = statePath(sessionId);
  if (!existsSync(sp)) {
    console.error(`session-stop: no state for ${sessionId}`);
    return;
  }
  const state = JSON.parse(readFileSync(sp, "utf8"));

  // Ask the tail worker to drain and exit.
  if (state.tailPid) {
    try { process.kill(state.tailPid, "SIGTERM"); } catch (e) { log(sessionId, `kill failed: ${e.message}`); }
  }

  // Give the worker up to ~3s to flush.
  const deadline = Date.now() + 3000;
  while (Date.now() < deadline) {
    try { process.kill(state.tailPid, 0); } catch { break; }
    await new Promise((r) => setTimeout(r, 100));
  }

  const closedAt = now();
  const duration = Math.max(0, Date.parse(closedAt) - Date.parse(state.startedAt));
  try {
    await postEvents([{
      type: "trace.closed",
      at: closedAt,
      traceId: state.traceId,
      sessionId,
      status: "done",
      duration,
    }]);
  } catch (e) {
    log(sessionId, `trace.closed failed: ${e.message}`);
  }

  try { unlinkSync(sp); } catch {}
};

// ─────────────────────────── dispatch ───────────────────────────

const cmd = process.argv[2];
const run = async () => {
  if (cmd === "session-start") return sessionStart();
  if (cmd === "session-stop") return sessionStop();
  if (cmd === "tail") return tailLoop();
  if (cmd === "memory-fetch") return memoryFetch();
  if (cmd === "memory-write") return memoryWrite();
  if (cmd === "gitnexus-index") return gitnexusIndex();
  if (cmd === "daemon-start") return daemonStart();
  if (cmd === "daemon-stop") return daemonStop();
  if (cmd === "daemon-status") return daemonStatus();
  console.error("usage: traceframe <session-start|session-stop|tail|memory-fetch|memory-write|gitnexus-index|daemon-start|daemon-stop|daemon-status>");
  process.exit(2);
};
run().catch((e) => { console.error(e); process.exit(1); });
