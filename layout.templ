package main

// Layout is the page shell. It replaces the hand-written markup at the top of
// static/index.html, which had an orphan </div> after the subtitle and never
// closed either <section>. Browsers auto-repaired that; templ will not.
templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/app.css"/>
			<script src="/htmx.min.js" defer></script>
		</head>
		<body>
			<main>
				<header class="app-header">
					<div>
						<h1>Traceframe</h1>
						<p class="subtitle">
							Hook events from your coding agents, grouped by the
							message that triggered them.
						</p>
					</div>
					<button class="refresh" type="button" hx-get="/ui/main" hx-target="#app" hx-swap="innerHTML">
						Refresh
					</button>
				</header>
				<div id="app">
					{ children... }
				</div>
			</main>
			<div class="scrim" id="scrim" hx-on:click="document.getElementById('drawer').classList.remove('open'); this.classList.remove('open')"></div>
			<aside class="drawer" id="drawer" aria-label="Raw payload">
				<div id="drawer-content"></div>
			</aside>
			@shell()
		</body>
	</html>
}

// shell is the only script in the app. Everything the old static/index.html
// did in the browser is now rendered on the server; what remains are the three
// things a server genuinely cannot do for itself.
templ shell() {
	<script>
		// 1. The server formats timestamps, so it needs the viewer's zone.
		// It arrives as a cookie; the first load reloads once to pick it
		// up, and thereafter this is a no-op.
		(function () {
			const zone = Intl.DateTimeFormat().resolvedOptions().timeZone;
			if (!zone) return;
			const current = document.cookie.split("; ").find((c) => c.startsWith("tf_tz="));
			if (current === "tf_tz=" + encodeURIComponent(zone)) return;
			document.cookie = "tf_tz=" + encodeURIComponent(zone) + "; path=/; max-age=31536000; samesite=lax";
			window.location.reload();
		})();

		// 2. Confirm destructive requests. htmx fires this for any element
		// carrying data-confirm, which keeps the prompt text in the markup
		// next to the button that needs it.
		document.body.addEventListener("htmx:confirm", function (e) {
			const message = e.detail.elt.getAttribute("data-confirm");
			if (!message) return;
			e.preventDefault();
			if (window.confirm(message)) e.detail.issueRequest(true);
		});

		// 3. Copy the raw payload. The drawer renders a JSON tree, not the
		// source text, so the button re-fetches the API representation.
		document.body.addEventListener("click", async function (e) {
			const button = e.target.closest("[data-copy-target]");
			if (!button) return;
			const label = button.textContent;
			try {
				const res = await fetch(button.getAttribute("data-copy-target"));
				await navigator.clipboard.writeText(JSON.stringify(await res.json(), null, 2));
				button.textContent = "Copied";
			} catch {
				button.textContent = "Copy failed";
			}
			setTimeout(() => { button.textContent = label; }, 1500);
		});
	</script>
}

// Page is the whole two-panel body: session sidebar plus the events panel.
// It is both the initial render and the target of the refresh button, so the
// same component serves a full page load and an htmx swap.
templ Page(rc renderContext, sessions []sidebarSession, totals sidebarSession, content templ.Component) {
	<section class="layout">
		<aside class="panel sessions" aria-label="Sessions">
			<div class="section-title">Sessions</div>
			<div
				class="session-list"
				id="sessions"
				hx-get={ uiURL("/ui/sessions", "session", rc.SelectedSession) }
				hx-trigger="every 5s"
				hx-swap="innerHTML"
			>
				@Sidebar(rc, sessions, totals)
			</div>
		</aside>
		<section class="panel events" aria-label="Hook events">
			@content
		</section>
	</section>
}

templ Sidebar(rc renderContext, sessions []sidebarSession, totals sidebarSession) {
	@SessionButton(rc, totals)
	for _, session := range sessions {
		@SessionButton(rc, session)
	}
}

templ SessionButton(rc renderContext, session sidebarSession) {
	<button
		type="button"
		class={ "session-button", templ.KV("active", rc.SelectedSession == session.ID) }
		hx-get={ uiURL("/ui/main", "session", session.ID) }
		hx-target="#app"
		hx-swap="innerHTML"
		hx-push-url={ uiURL("/", "session", session.ID) }
	>
		<div>
			<div class="session-name">{ session.Name }</div>
			<div class="session-meta">{ session.Meta() }</div>
		</div>
		<div class="session-count">{ session.Count }</div>
	</button>
}
